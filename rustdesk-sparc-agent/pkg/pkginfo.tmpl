PKG=RDVTagent
NAME=R-DeskVint remote desktop agent
ARCH=sparc
VERSION=@VERSION@
CATEGORY=application
VENDOR=R-DeskVint
BASEDIR=/opt/rdeskvint
CLASSES=none
PSTAMP=@PSTAMP@
MAXINST=1
DESC=Remote desktop agent (the controlled side) speaking the RustDesk protocol. Built for 64-bit SPARC and linked against Solaris 9, so it runs on Solaris 9 and later. Installing this package changes nothing about how the machine starts up; run rdeskvint-enable to wire it in.

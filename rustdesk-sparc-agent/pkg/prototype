#
# SVR4 prototype for RDVTagent. Paths are relative to BASEDIR (/opt/rdeskvint),
# so this package is relocatable with `pkgadd -a` or an admin file, and it owns
# nothing outside its own directory.
#
# That is deliberate. Everything this package could put in /etc -- an rc script,
# an rc link, a CDE session hook -- is installed by rdeskvint-enable instead and
# taken away by rdeskvint-disable. So `pkgadd` is inert: it drops files on the
# disk and the machine behaves exactly as it did before. Nothing starts, nothing
# is disabled, and nothing has to be undone if you decide against it.
#
i pkginfo
i postinstall
i preremove
i postremove
#
d none bin 0755 root bin
f none bin/rdeskvint 0755 root bin
f none bin/rdeskvint-enable 0755 root bin
f none bin/rdeskvint-disable 0755 root bin
f none bin/rdeskvint-session 0755 root bin
f none bin/rdeskvint-share-config 0755 root bin
f none bin/rdeskvint-console-test 0755 root bin
#
# The CA bundle, beside the binary because that is the first place the agent
# looks. Solaris 9's own trust store is from 2002 and cannot verify anything on
# the modern internet, so without this an https API Server fails at the
# handshake -- on a machine whose whole problem is that it is twenty years old
# and cannot be given a newer one.
f none bin/cacert.pem 0644 root bin
#
# The GCC runtime, which Solaris 9 does not ship and Rust's unwind crate asks
# for by name -- which is why -static-libgcc cannot answer it. The agent carries
# an rpath naming this directory, so a default install needs nothing on
# LD_LIBRARY_PATH. It lives here rather than in /usr/lib/sparcv9 so that it is
# this package's copy for this package's binary, and not a GCC runtime sitting
# in a system directory for some unrelated program to find in a year's time.
d none lib 0755 root bin
f none lib/libgcc_s.so.1 0755 root bin
f none lib/rdeskvint.init 0644 root bin
f none lib/rdeskvint.xsession 0644 root bin
#
d none doc 0755 root bin
f none doc/README.txt 0644 root bin
#
# On PATH, for the two commands a person actually types. /usr/bin because that
# is what is on the default PATH here -- /usr/local/bin is not, and does not
# exist on a stock Solaris 9.
#
# Symlinks rather than a line added to /etc/profile: a package that edits a
# shared system file has to un-edit it exactly on removal, and gets one chance
# to get that right on a file the admin may also have changed. These are owned
# by the package, so pkgrm takes them away and nothing else is touched.
#
# Only these two. The rest -- enable, disable, share-config, console-test -- are
# root one-offs run from the instructions with a full path, and six third-party
# symlinks in Sun's own bin directory is more footprint than the convenience is
# worth.
#
# Safe despite the agent finding cacert.pem beside its own binary: current_exe()
# resolves the link on Solaris, verified on the machine.
s none /usr/bin/rdeskvint=/opt/rdeskvint/bin/rdeskvint
s none /usr/bin/rdeskvint-session=/opt/rdeskvint/bin/rdeskvint-session

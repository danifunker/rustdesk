#!/bin/sh
#
# rdeskvint-disable -- undo whatever rdeskvint-enable did, in either mode, and
# stop a running agent.
#
#   rdeskvint-disable          take it back out of startup
#   rdeskvint-disable -h       this text
#
# Safe to run when nothing is enabled, and safe to run twice. It removes both
# modes' hooks without being told which one was used, because the machine may
# well have been through both and only the filesystem knows.
#
# CDE's login manager is turned back on if boot mode had turned it off. That is
# the one thing here that changes the machine rather than restoring it, and it
# is the right default: leaving a machine with no login manager and no agent is
# leaving it with no way in at all.
#
# The configuration -- ~/.rustdesk-ppc-agent.conf, which holds the machine's ID
# and its signing key -- is deliberately left alone. Removing an autostart hook
# should not throw away the identity peers know this machine by.
#
# Bourne shell: no $( ), no [[ ]], no `local`.

set -u

XSESSION_HOOK=/etc/dt/config/Xsession.d/0100.rdeskvint
INIT_SCRIPT=/etc/init.d/rdeskvint
RC_LINK=/etc/rc3.d/S99rdeskvint

[ "${1:-}" = "-h" ] && { sed -n '2,22p' "$0"; exit 0; }

id | grep 'uid=0(' > /dev/null 2>&1 || {
	echo "rdeskvint-disable: run this as root." >&2; exit 1; }

was_boot=0
[ -f "$INIT_SCRIPT" ] && was_boot=1

# Stop it before unhooking it, and while the init script is still there to know
# how: in boot mode it owns an Xsun and a window manager as well as the agent.
if [ -x "$INIT_SCRIPT" ]; then
	"$INIT_SCRIPT" stop > /dev/null 2>&1
fi

# By exact name. `pkill -f rdeskvint` would match this script's own
# command line when it is run from a directory with that name in it, and has.
pkill -x rdeskvint > /dev/null 2>&1

removed=0
if [ -f "$XSESSION_HOOK" ]; then
	rm -f "$XSESSION_HOOK" && echo "Removed $XSESSION_HOOK"
	removed=1
fi
if [ -f "$RC_LINK" ] || [ -L "$RC_LINK" ]; then
	rm -f "$RC_LINK" && echo "Removed $RC_LINK"
	removed=1
fi
if [ -f "$INIT_SCRIPT" ]; then
	rm -f "$INIT_SCRIPT" && echo "Removed $INIT_SCRIPT"
	removed=1
fi

if [ "$was_boot" = 1 ]; then
	echo "Turning the CDE login manager back on (dtconfig -e)."
	/usr/dt/bin/dtconfig -e > /dev/null 2>&1 ||
		echo "  warning: dtconfig -e failed; check /etc/rc2.d for S99dtlogin"
	if [ -x /etc/init.d/dtlogin ]; then
		/etc/init.d/dtlogin start > /dev/null 2>&1
		echo "Started dtlogin; the console should show a login screen again."
	fi
fi

if [ "$removed" = 0 ]; then
	echo "Nothing was enabled. Any running agent has been stopped."
else
	echo "Done. The configuration in ~/.rustdesk-ppc-agent.conf is left alone."
fi

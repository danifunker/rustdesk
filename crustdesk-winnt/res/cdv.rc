/* The settings window, the icon and the version. */
#include <windows.h>
#include "resource.h"

IDI_CDV ICON "cdv.ico"

/* The screen hooks' DLL, written beside the program when it runs (hooks.c).
 * The stage's nmake builds it first and says so; PINT's build does not. */
#ifdef CDV_HOOK_DLL
IDR_HOOKDLL RCDATA "cdvhook.dll"
#endif

IDD_MAIN DIALOG 0, 0, 400, 224
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "C-Desk-Vint"
FONT 8, "MS Sans Serif"
BEGIN
    /* Two columns, so it fits a 640x480 screen with room for the taskbar. */
    GROUPBOX        "This machine", -1, 7, 4, 192, 50
    LTEXT           "ID:", -1, 15, 18, 44, 8
    EDITTEXT        IDC_ID, 62, 16, 76, 12, ES_READONLY | NOT WS_TABSTOP
    LTEXT           "Password:", -1, 15, 36, 44, 8
    EDITTEXT        IDC_PASSWORD, 62, 34, 76, 12, ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON      "Show", IDC_SHOWPW, 142, 33, 26, 14
    PUSHBUTTON      "New", IDC_NEWPW, 171, 33, 22, 14

    GROUPBOX        "Service", -1, 7, 58, 192, 44
    LTEXT           "", IDC_SVCSTATE, 15, 70, 178, 8
    PUSHBUTTON      "&Install", IDC_INSTALL, 15, 82, 42, 14
    PUSHBUTTON      "&Start", IDC_START, 60, 82, 42, 14
    PUSHBUTTON      "S&top", IDC_STOP, 105, 82, 42, 14
    PUSHBUTTON      "&Remove", IDC_REMOVE, 150, 82, 43, 14

    GROUPBOX        "Sessions", -1, 7, 106, 192, 62
    LTEXT           "File access:", -1, 15, 120, 54, 8
    EDITTEXT        IDC_FILES, 72, 118, 70, 12, ES_AUTOHSCROLL
    /* two lines, between the box above (ends at 130) and quality (148) */
    LTEXT           "/ = all drives, files and folders\noff = none, or one folder (D:\\Shared)",
                    -1, 15, 131, 178, 16
    LTEXT           "Picture quality:", -1, 15, 150, 54, 8
    EDITTEXT        IDC_QUALITY, 72, 148, 24, 12, ES_NUMBER
    LTEXT           "0 best ... 127 smallest; 24", -1, 100, 150, 93, 8

    GROUPBOX        "Network", -1, 206, 4, 187, 164
    LTEXT           "ID server:", -1, 214, 18, 52, 8
    EDITTEXT        IDC_SERVER, 268, 16, 118, 12, ES_AUTOHSCROLL
    LTEXT           "Key:", -1, 214, 36, 52, 8
    EDITTEXT        IDC_KEY, 268, 34, 118, 12, ES_AUTOHSCROLL
    LTEXT           "Relay server:", -1, 214, 54, 52, 8
    EDITTEXT        IDC_RELAY, 268, 52, 118, 12, ES_AUTOHSCROLL
    LTEXT           "Console (API):", -1, 214, 72, 52, 8
    EDITTEXT        IDC_API, 268, 70, 118, 12, ES_AUTOHSCROLL
    LTEXT           "Direct IP port:", -1, 214, 90, 52, 8
    EDITTEXT        IDC_PORT, 268, 88, 36, 12, ES_NUMBER
    CONTROL         "Answer LAN discovery", IDC_LAN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 214, 108, 170, 10
    LTEXT           "Port 0 turns direct access off.", -1, 214, 128, 172, 8
    LTEXT           "An empty ID server: no ID, by address only.", -1, 214, 140, 172, 8
    CONTROL         "Read only what changed (screen hooks)", IDC_HOOK, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 214, 153, 170, 10

    LTEXT           "Log folder:", -1, 7, 174, 50, 8
    EDITTEXT        IDC_LOGDIR, 60, 172, 200, 12, ES_AUTOHSCROLL
    LTEXT           "empty: beside the program", -1, 266, 174, 127, 8

    LTEXT           "", IDC_STATUS, 7, 190, 386, 10
    PUSHBUTTON      "View &log", IDC_LOG, 7, 204, 54, 14
    PUSHBUTTON      "&Apply", IDC_APPLY, 282, 204, 54, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 339, 204, 54, 14
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "C-Desk-Vint\0"
            VALUE "FileDescription", "C-Desk-Vint remote desktop agent for RustDesk\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "ProductName", "C-Desk-Vint for Windows NT\0"
            VALUE "ProductVersion", "1.0.0\0"
            VALUE "LegalCopyright", "AGPL-3.0, with BearSSL (MIT), libsodium (ISC), zstd (BSD)\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Run the agent inside the logged-in user's GUI ("Aqua") session.

  This used to say "convenience rather than necessity", because capture works
  fine from an ordinary ssh login. **The clipboard does not.** PasteboardCreate
  returns -4960 from an ssh login and from the detached `screen` that
  build-ppc.sh uses, and pbcopy and pbpaste fail there too -- so it is the
  session and not the API, and capture is no guide to it. Measured with
  probes/pasteboard.c and probes/clipshim.c.

  So: the clipboard works only when the agent is started from here. Everything
  else works either way.

  Install:
      scp deploy/com.rustdesk.ppc-agent.plist \
          ppctiger:~/Library/LaunchAgents/com.rustdesk.ppc-agent.plist

  Then, *in Terminal.app on the G5 itself* (an ssh session cannot reach the Aqua
  session's launchd):
      launchctl unload ~/Library/LaunchAgents/com.rustdesk.ppc-agent.plist
      launchctl load -w ~/Library/LaunchAgents/com.rustdesk.ppc-agent.plist

  It also loads by itself at every login, so that is only needed to start it
  without logging out first.

  **Only one agent at a time.** Both this and `build-ppc.sh deploy` bind port
  21118, and they interact badly in both directions: a launchd-started agent
  will lose the port to a screen-started one, and `deploy` kills by process name,
  which kills the launchd copy -- whereupon KeepAlive restarts it and the two
  take turns failing to bind. Stop the screen one first:

      ssh ppctiger 'screen -S rdagent -X quit'

  and use `launchctl unload` before deploying a new binary from the host.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rustdesk.ppc-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/admin/rustdesk-agent</string>
        <string>--port</string>
        <string>21118</string>
        <string>-vv</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Only ever in the GUI session; a background session cannot capture. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/Users/admin/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/agent.log</string>
</dict>
</plist>

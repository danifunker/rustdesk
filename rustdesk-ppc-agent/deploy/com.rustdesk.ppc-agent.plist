<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Run the agent inside the logged-in user's GUI ("Aqua") session.

  Convenience rather than necessity: capture works fine from an ordinary ssh
  login, so this exists to start the agent at every login and restart it if it
  dies, without anyone having to ssh in.

  Install:
      scp deploy/com.rustdesk.ppc-agent.plist \
          ppctiger:~/Library/LaunchAgents/com.rustdesk.ppc-agent.plist

  Then, *in Terminal.app on the G5 itself* (an ssh session cannot reach the Aqua
  session's launchd):
      launchctl load -w ~/Library/LaunchAgents/com.rustdesk.ppc-agent.plist

  It also loads by itself at every login, so that command is only needed to start
  it without logging out first.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rustdesk.ppc-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/admin/rustdesk-agent</string>
        <string>--port</string>
        <string>21118</string>
        <string>-vv</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Only ever in the GUI session; a background session cannot capture. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/Users/admin/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/agent.log</string>
</dict>
</plist>

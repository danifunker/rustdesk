#! /sbin/sh
#Tag 0x00000f00
#
# Start and stop the RustDesk agent.
#
# Installed by `agent-helper.sh service install`, which also makes the rc
# links and registers the chkconfig flag. Turn it on with:
#
#	chkconfig r_deskvint_irix on
#
# Ordering: S99 in rc2.d, after xdm at S98; K01 in rc0.d, before xdm at K02, so
# the agent is down before the server it might be holding a connection to.
#
# It does NOT wait for X, and that is deliberate. At a login screen the server
# accepts a connection and serves nobody until someone logs in, so "is X ready"
# has no useful answer at boot -- an earlier version of this script polled
# xdpyinfo, which blocks in exactly that state, and started nothing for two
# minutes. The agent does not need a display to start: it registers with the
# rendezvous server, listens, and opens a capture when a peer actually arrives,
# retrying every few seconds until one can be opened. Registering is the job
# that matters when nobody is logged in.
#
# Everything here defers to agent-helper.sh rather than starting the binary
# itself. The helper already knows the three things that are easy to get wrong
# -- nohup so the agent outlives the calling shell, DISPLAY, and matching the
# process by the basename of argv[0] rather than by a command line that also
# matches the panel and this script -- and having two places that know them is
# how they drift.

IS_ON=/etc/chkconfig
HELPER=/usr/local/lib/r-deskvint-irix/agent-helper.sh

if $IS_ON verbose; then
	ECHO=echo
else
	# For a quiet startup and shutdown
	ECHO=:
fi

case "$1" in
'start')
	$IS_ON r_deskvint_irix || exit 0
	if [ ! -x "$HELPER" ]; then
		echo "r_deskvint_irix: no helper at $HELPER; not starting."
		exit 1
	fi
	$ECHO "Starting the RustDesk agent."
	DISPLAY=:0 $HELPER start > /dev/null 2>&1
	;;

'stop')
	[ -x "$HELPER" ] || exit 0
	$ECHO "Stopping the RustDesk agent."
	$HELPER stop > /dev/null 2>&1
	;;

*)
	echo "usage: $0 {start|stop}"
	exit 1
	;;
esac

exit 0
